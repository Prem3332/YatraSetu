# ─────────────────────────────────
# PilgrimSafe — .gitignore
# ─────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# Build output
dist/
build/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Testing
coverage/
.nyc_output/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
*.egg
venv/
.venv/

# Redis dump
dump.rdb

# Exports
exports/
