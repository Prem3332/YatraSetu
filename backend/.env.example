# ============================================
# PilgrimSafe — Environment Variables Template
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================

# --- PostgreSQL (Railway) ---
# Copy the actual value from Railway dashboard → Postgres service → "Connect" tab → "Postgres Connection URL"
# Replace <PASSWORD>, <RAILWAY_HOST>, and <PORT> with your actual Railway credentials.
DATABASE_URL="postgresql://postgres:<PASSWORD>@<RAILWAY_HOST>.proxy.rlwy.net:<PORT>/railway"

# --- Server ---
PORT=5000
NODE_ENV=development

# --- JWT Authentication ---
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# --- Redis (Queue & Caching) ---
REDIS_URL=redis://localhost:6379

# --- Firebase Cloud Messaging (Push Notifications) ---
FCM_SERVER_KEY=your_firebase_server_key_here

# --- SMS Gateway (Twilio / MSG91) ---
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=PLGRM

# --- ML Prediction Service ---
ML_SERVICE_URL=http://localhost:8000

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
